{
  "$schema": "../schema.json",
  "title": "A null meets required, then fails a type that does not admit it",
  "rules": [
    "CFG-9",
    "CFG-10"
  ],
  "operation": "resolve-parameters",
  "given": {
    "parameters": {
      "x": {
        "schema": {
          "type": "string"
        },
        "required": true,
        "connectable": true,
        "exposed": true,
        "configurable": true
      }
    },
    "config": {
      "x": null
    }
  },
  "expect": {
    "failed": {
      "parameter": "x",
      "error": "validation",
      "constraint": "type"
    }
  }
}
