{
  "$schema": "../schema.json",
  "title": "A null meets required, then fails a type that does not admit it",
  "rules": [
    "CFG-10",
    "CFG-9"
  ],
  "operation": "resolve-parameters",
  "given": {
    "parameters": {
      "x": {
        "schema": {
          "type": "string"
        },
        "required": true,
        "connectable": true,
        "exposed": true,
        "configurable": true
      }
    },
    "config": {
      "x": null
    }
  },
  "expect": {
    "failed": {
      "error": "validation",
      "constraints": {
        "x": [
          "type"
        ]
      }
    }
  }
}
