{
  "$schema": "../schema.json",
  "title": "A recorded null default is a default, and wins over the schema's",
  "rules": [
    "CFG-3",
    "CFG-6",
    "CFG-14"
  ],
  "operation": "resolve-parameters",
  "given": {
    "parameters": {
      "x": {
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "default": "schema"
        },
        "default": null,
        "connectable": true,
        "exposed": true,
        "configurable": true
      }
    }
  },
  "expect": {
    "resolved": {
      "x": null
    }
  }
}
