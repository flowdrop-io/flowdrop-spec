{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.flowdrop.io/schema/rule.json",
  "title": "FlowDrop specification rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "part", "title", "normative", "posture", "level", "profiles", "added", "changed"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$",
      "description": "Permanent identifier. Never renumbered, never reused."
    },
    "family": { "type": "string", "pattern": "^(GR|RT)-[A-Z]+$" },
    "part": { "enum": ["I", "II"] },
    "title": { "type": "string", "minLength": 4, "maxLength": 90 },
    "summary": { "type": "string" },
    "normative": {
      "type": "string",
      "minLength": 20,
      "description": "The binding sentence(s). Implementation-independent."
    },
    "posture": { "enum": ["normative-target", "descriptive", "deprecated", "withdrawn"] },
    "level": { "enum": ["core", "extended", "optional"] },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["runtime", "storage-api", "editor-client"] }
    },
    "added": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "changed": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "rulings": { "type": "array", "items": { "type": "string", "pattern": "^(OPEN|DF)-[0-9]+$" } },
    "related": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$" } },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normative": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "informative": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      }
    },
    "supersededBy": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$" }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "title", "note"],
      "properties": {
        "source": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "note": {
          "type": "string",
          "description": "What this rule takes from the source. If you cannot write one, do not cite it."
        }
      }
    }
  }
}
