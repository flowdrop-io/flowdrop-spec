{
  "$schema": "../schema.json",
  "title": "An unwired dynamic input is absent; a null on its wire is present",
  "rules": [
    "DYN-4",
    "CFG-13",
    "DYN-8"
  ],
  "operation": "resolve-parameters",
  "given": {
    "parameters": {},
    "dynamicParameters": [
      {
        "name": "a",
        "connectable": true, "exposedByDefault": true
      },
      {
        "name": "b",
        "connectable": true, "exposedByDefault": true
      }
    ],
    "inputs": {
      "b": null
    }
  },
  "expect": {
    "resolved": {
      "b": null
    }
  }
}
