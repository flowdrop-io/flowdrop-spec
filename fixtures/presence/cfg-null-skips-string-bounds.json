{
  "$schema": "../schema.json",
  "title": "A null is not held to string-only constraints",
  "rules": [
    "CFG-10"
  ],
  "operation": "resolve-parameters",
  "given": {
    "parameters": {
      "x": {
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "pattern": "^[a-z]+$"
        },
        "connectable": true,
        "exposed": true,
        "configurable": true
      }
    },
    "config": {
      "x": null
    }
  },
  "expect": {
    "resolved": {
      "x": null
    }
  }
}
